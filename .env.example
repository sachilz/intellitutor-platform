# IntelliLearn Microservices Platform Environment Variables (.env.example)
# Copy this file to .env and fill in your actual credentials.

# MongoDB Atlas Connection Strings (Dedicated Database per Microservice)
USER_SERVICE_MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/userdb?retryWrites=true&w=majority
COURSE_SERVICE_MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/coursedb?retryWrites=true&w=majority
PROGRESS_SERVICE_MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/progressdb?retryWrites=true&w=majority
QUIZ_SERVICE_MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/quizdb?retryWrites=true&w=majority
TUTOR_SERVICE_MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tutordb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/progressdb?retryWrites=true&w=majority

# Microservice API Keys
USER_SERVICE_API_KEY=user-service-secret-key-123
COURSE_SERVICE_API_KEY=course-service-secret-key-456
PROGRESS_SERVICE_API_KEY=progress-service-secret-key-789
